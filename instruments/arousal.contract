// The arousal curve, played three ways. The trace is drawn live from the
// engine (engine.contract): you are not shown a curve, you make one.
//   building:   press and hold; it starts slowly, then carries itself
//   plateauing: set how much touch there is; find the amount that holds it
//   edging:     climb toward the edge, let go, climb again
use clamp01, span, Caption, Chip from "./kit.contract"

fn arY(level: number): number = 214 - 170 * level
fn arX(i: number, n: number): number = 304 - (n - 1 - i) * 2.5
fn arLine(trace: number[]): string = trace.map((v, i) => `${arX(i, trace.length).toFixed(1)},${arY(v).toFixed(1)}`).join(" ")
fn arArea(trace: number[]): string = trace.length == 0 ? "" : `${arX(0, trace.length).toFixed(1)},214 ${arLine(trace)} 304,214`
fn arTrend(trace: number[], level: number): number = level - match trace.at(-9) { case some(v) => v, case none => level }

fn arBuilding(level: number, input: number, touched: bool): string = not touched ? "Press and hold. Stay with it, even while little seems to happen." : input > 0 and level < 0.2 ? "Barely anything yet: a little warmth. This slow start is the build, not a delay." : input > 0 and level < 0.55 ? "Gathering. Each moment is adding to the last." : input > 0 ? "Now it carries itself. This is what the slow start was making room for." : level > 0.03 ? "You paused, and it did not vanish. Arousal fades slowly: a pause is not a reset." : "Back to rest. Press and hold to build again."
fn arPlateau(level: number, input: number, trend: number, touched: bool): string = not touched ? "Slide to set how much touch there is, then watch what the level does." : level > 0.3 and trend < 0.012 and trend > -0.012 and input > 0 ? "Holding. Not climbing, not fading: a hover you can stay in for as long as it is good." : trend >= 0.012 ? "More touch than it takes to hold, so it is still climbing." : level > 0.03 ? "Less touch than it takes to hold, so it is easing down. Nothing has gone wrong." : "At rest. Slide toward more touch."
fn arEdging(level: number, input: number, near: bool, edges: number, releasing: bool, touched: bool): string = releasing ? (edges > 0 ? "Over the edge. After approaching and easing back, release often lands deeper." : "Over the edge. Next time, try letting go just before, and climbing again.") : not touched ? "Hold to climb toward the edge. Let go before you tip over." : input > 0 and level >= 0.82 ? "Close. Let go now, and let it ease back." : input > 0 ? (edges > 0 ? "Climbing again, from higher ground this time." : "Climbing.") : near ? "Easing back from the edge. The wanting stays." : edges > 0 and level > 0.03 ? "That was an approach. Climb again whenever you like." : level > 0.03 ? "Easing down." : "At rest. Hold to climb."

keyframes ar-breathe
  50% opacity=0.5

keyframes ar-wave
  from r=8 opacity=0.7
  to r=150 opacity=0

component ArousalCurve
  inject
    still: bool
    aMode: string
    aLevel: number
    aInput: number
    aTrace: number[]
    aNear: bool
    aEdges: number
    aReleasing: bool
    aTouched: bool
    aBegin: action
    aEnd: action
    aReset: action
  props
    uid: string
    mode: string
  state down = false
  derive mine = aMode == mode
  derive level = mine ? aLevel : mode == "plateauing" ? 0.5 : 0
  derive input = mine ? aInput : 0
  derive trace = mine ? aTrace : []
  derive touched = mine and aTouched
  derive releasing = mine and aReleasing
  derive trend = arTrend(trace, level)
  derive line = mode == "building" ? arBuilding(level, input, touched) : mode == "plateauing" ? arPlateau(level, input, trend, touched) : arEdging(level, input, mine and aNear, mine ? aEdges : 0, releasing, touched)
  action press(e: PointerEvent)
    down = true
    if mode == "plateauing"
      aBegin(mode, clamp01((e.offsetX / frame(`ar-${uid}`).width * 340 - 44) / 252))
    else
      aBegin(mode, 1)
  action drag(e: PointerEvent)
    if down and mode == "plateauing"
      aBegin(mode, clamp01((e.offsetX / frame(`ar-${uid}`).width * 340 - 44) / 252))
  action release(e: PointerEvent)
    down = false
    if mode != "plateauing"
      aEnd()
  action keydown(k: string, e: KeyboardEvent)
    if mode == "plateauing"
      if k == "ArrowRight" or k == "ArrowUp"
        aBegin(mode, clamp01(input + 0.1))
      if k == "ArrowLeft" or k == "ArrowDown"
        aBegin(mode, clamp01(input - 0.1))
    else
      if k == " " or k == "Enter"
        aBegin(mode, 1)
  action keyup(k: string, e: KeyboardEvent)
    if mode != "plateauing"
      aEnd()
  action touch(amount: number)
    aBegin(mode, amount)
  action again
    aReset(mode)
  view
    column gap=14
      svg id=`ar-${uid}` testId="ar-stage" viewBox="0 0 340 300" width="100%" display="block" touch-action="none" tabindex=0
        role=(mode == "plateauing" ? "slider" : "button") aria-label=(mode == "plateauing" ? "How much touch" : "Press and hold to build arousal")
        aria-valuetext=line key=keydown keyup=keyup pointerdown=press pointermove=drag pointerup=release
        defs
          linearGradient id="ar-fill" x1=0 y1=0 x2=0 y2=1
            stop offset=0 stop-color="ember" stop-opacity=0.5
            stop offset=1 stop-color="ember" stop-opacity=0
          radialGradient id="ar-glow"
            stop offset=0 stop-color="ember" stop-opacity=0.7
            stop offset=1 stop-color="ember" stop-opacity=0
          linearGradient id="ar-edge" x1=0 y1=0 x2=0 y2=1
            stop offset=0 stop-color="honey" stop-opacity=0.42
            stop offset=1 stop-color="honey" stop-opacity=0
          clipPath id="ar-clip"
            rect x=24 y=20 width=292 height=196
        // The ground: rest at the bottom, and for edging the edge at the top.
        line x1=24 y1=214 x2=316 y2=214 stroke="ink.faint" stroke-width=1.5 stroke-linecap="round"
        if mode == "edging"
          rect x=24 y=44 width=292 height=31 fill="url(#ar-edge)"
          line x1=24 y1=44 x2=316 y2=44 stroke="honey" stroke-width=1.5 stroke-dasharray="2 6" stroke-linecap="round"
          text "the edge" x=28 y=38 font-size=11 fill="ink.soft"
        if mode == "building"
          g font-size=10.5 fill="ink.soft"
            text "a little warmth" x=28 y=(arY(0.12) - 5) opacity=(0.35 + 0.65 * (1 - span(level, 0.12, 0.3)))
            text "gathering" x=28 y=(arY(0.45) - 5) opacity=(0.3 + 0.7 * span(level, 0.25, 0.45) * (1 - span(level, 0.6, 0.75)))
            text "undeniable" x=28 y=(arY(0.82) - 5) opacity=(0.3 + 0.7 * span(level, 0.6, 0.8))
        if mode == "plateauing"
          g font-size=10.5 fill="ink.soft"
            text "climbing" x=28 y=62 opacity=(trend >= 0.012 ? 1 : 0.3)
            text "holding" x=28 y=126 opacity=(level > 0.3 and trend < 0.012 and trend > -0.012 and input > 0 ? 1 : 0.3)
            text "easing" x=28 y=190 opacity=(trend <= -0.012 ? 1 : 0.3)
        // The trace you are making.
        g clip-path="url(#ar-clip)"
          polygon points=arArea(trace) fill="url(#ar-fill)"
          polyline points=arLine(trace) fill="none" stroke="ember" stroke-width=2.5 stroke-linecap="round" stroke-linejoin="round"
        if releasing and not still
          circle cx=304 cy=arY(level) r=8 fill="none" stroke="ember" stroke-width=2 animation="ar-wave 1.6s ease-out infinite"
        circle cx=304 cy=arY(level) r=(10 + 22 * level) fill="url(#ar-glow)"
        circle cx=304 cy=arY(level) r=5.5 fill="ember" stroke="paper.raised" stroke-width=2
          animation=(still or level > 0 ? "none" : "ar-breathe 2.6s ease-in-out infinite")
        // The touch: a pad to hold, or for plateauing a rail to set.
        if mode == "plateauing"
          g
            line x1=44 y1=262 x2=296 y2=262 stroke="paper.sunk" stroke-width=10 stroke-linecap="round"
            line x1=44 y1=262 x2=(44 + 252 * input) y2=262 stroke="ember" stroke-width=10 stroke-linecap="round" opacity=0.55
            circle cx=(44 + 252 * input) cy=262 r=13 fill="paper" stroke="ember" stroke-width=3
            text "less touch" x=44 y=292 font-size=10.5 fill="ink.soft"
            text "more touch" x=296 y=292 font-size=10.5 fill="ink.soft" text-anchor="end"
        else
          g
            rect x=24 y=238 width=292 height=48 rx=24 fill=(input > 0 ? "ember.glow" : "paper.sunk") transition="fill 240ms ease"
            circle cx=170 cy=262 r=(input > 0 ? 15 : 9) fill="ember" opacity=(input > 0 ? 0.9 : 0.35) transition="r 240ms ease, opacity 240ms ease"
            text (input > 0 ? "holding" : "press and hold") x=170 y=266 text-anchor="middle" font-size=11.5 fill="ink.soft"
              opacity=(input > 0 ? 0 : 1) translate="0px 24px" pointer-events="none"
      Caption(line=line)
      row gap=8 justify-content="center" flex-wrap="wrap"
        if mode == "plateauing"
          Chip(label="Less", on=(touched and input > 0 and input < 0.3), tone="ember", press=touch(0.15), tid="ar-less")
          Chip(label="Hold", on=(input >= 0.3 and input <= 0.42), tone="ember", press=touch(0.36), tid="ar-hold")
          Chip(label="More", on=(input > 0.42), tone="ember", press=touch(0.8), tid="ar-more")
        Chip(label="Start over", on=false, tone="ember", press=again, tid="ar-reset")
