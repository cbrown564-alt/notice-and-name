// Responsive Desire: a coal at rest, and the context that warms it. Arousal
// lifts first as context gathers; wanting only arrives once enough is already
// under way. Not feeling a spark beforehand is not low desire
// (Basson, 2000; Nagoski, 2015).
use clamp01, ease, span, rnd, Caption, Chip from "./kit.contract"

// The two curves, read against how much context is on (u from 0 to 4).
fn rdX(u: number): number = 188 + 34 * u
fn rdArousal(u: number): number = 178 - 104 * ease(u / 4.4)
fn rdDesire(u: number): number = 178 - 66 * ease(span(u, 2.3, 4.3))
// Each curve as a path of 16 straight steps up to the present warmth, so that
// it grows (and shrinks) point by point when `d` transitions.
fn rdArousalPath(w: number): string = range(17).map(k => `${k == 0 ? "M" : "L"}${rdX(w * k / 16).toFixed(1)} ${rdArousal(w * k / 16).toFixed(1)}`).join("")
fn rdDesirePath(w: number): string = range(17).map(k => `${k == 0 ? "M" : "L"}${rdX(2.3 + (max(w, 2.3) - 2.3) * k / 16).toFixed(1)} ${rdDesire(2.3 + (max(w, 2.3) - 2.3) * k / 16).toFixed(1)}`).join("")
fn rdNext(on: string[]): string = not on.includes("time") ? "time" : not on.includes("close") ? "close" : not on.includes("touch") ? "touch" : not on.includes("prove") ? "prove" : ""
fn rdLine(w: number, cooling: bool): string = w == 0 ? "No spark yet. That is not a no, and it is not a problem." : w >= 4 ? "Wanting, fully awake. It did not have to come first to be real." : w == 3 ? "And there it is: wanting, arriving second, once enough was already under way." : cooling ? "Take some of the context away and it cools again, slowly. Nothing went wrong: the conditions changed." : w == 1 ? "Something is warming. The body can begin to respond before any wanting shows up." : "Arousal is rising, and the wanting has not arrived yet. For many people this is simply the order of things."
fn rdSpoken(w: number): string = w == 0 ? "A coal at rest. No context added." : w < 3 ? `A coal warming. ${w} of 4 kinds of context added. Arousal is rising, desire has not arrived.` : `A coal glowing. ${w} of 4 kinds of context added. Arousal is up and desire has arrived.`

keyframes rd-rise
  from translate="0px 0px" opacity=0
  18% opacity=0.9
  to translate="5px -56px" opacity=0

keyframes rd-breathe
  50% opacity=0.6

keyframes rd-glow
  50% scale=1.06

component ResponsiveDesire
  inject
    still: bool
  props
    uid: string
  state on: string[] = []
  state cooling = false
  derive w = on.length
  action toggle(id: string)
    cooling = on.includes(id)
    on = on.includes(id) ? on.filter(x => x != id) : on.concat([id])
  // Touching the coal adds the next kind of context (on release, so a scroll does not).
  action warm(e: PointerEvent)
    if rdNext(on) != ""
      cooling = false
      on = on.concat([rdNext(on)])
  view
    column gap=14
      svg id=`rd-${uid}` testId="rd-stage" viewBox="0 0 340 228" width="100%" display="block" touch-action="manipulation"
        role="img" aria-label=rdSpoken(w) pointerup=warm
        defs
          radialGradient id="rd-halo"
            stop offset=0 stop-color="ember" stop-opacity=0.55
            stop offset=1 stop-color="ember" stop-opacity=0
          radialGradient id="rd-bloom"
            stop offset=0.45 stop-color="honey" stop-opacity=0
            stop offset=0.72 stop-color="honey" stop-opacity=0.5
            stop offset=1 stop-color="honey" stop-opacity=0
          radialGradient id="rd-rest" cx="42%" cy="36%" r="80%"
            stop offset=0 stop-color="rose.deep"
            stop offset=1 stop-color="rose.deep" stop-opacity=0.86
          radialGradient id="rd-warm" cx="46%" cy="44%" r="70%"
            stop offset=0 stop-color="ember"
            stop offset=1 stop-color="rose.deep"
          radialGradient id="rd-hot" cx="46%" cy="46%" r="68%"
            stop offset=0 stop-color="ember.light"
            stop offset=0.5 stop-color="ember"
            stop offset=1 stop-color="ember" stop-opacity=0.2
          linearGradient id="rd-fill-arousal" x1=0 y1=0 x2=0 y2=1
            stop offset=0 stop-color="ember" stop-opacity=0.3
            stop offset=1 stop-color="ember" stop-opacity=0
          linearGradient id="rd-fill-desire" x1=0 y1=0 x2=0 y2=1
            stop offset=0 stop-color="honey" stop-opacity=0.4
            stop offset=1 stop-color="honey" stop-opacity=0
        // The coal.
        g
          ellipse cx=98 cy=141 rx=52 ry=6.5 fill="ink" opacity=(0.09 - 0.02 * w) transition=(still ? "none" : "opacity 900ms ease")
          // Desire, when it comes, blooms around it.
          circle cx=98 cy=100 r=88 fill="url(#rd-bloom)" opacity=(w >= 3 ? 1 : 0) scale=(w >= 4 ? 1 : w == 3 ? 0.86 : 0.6)
            transform-box="fill-box" transform-origin="center" transition=(still ? "none" : `opacity ${cooling ? 1800 : 900}ms ease, scale ${cooling ? 1800 : 1100}ms ease`)
          g animation=(still ? "none" : "rd-breathe 4.6s ease-in-out infinite")
            for i in range(14) key=i
              line x1=(98 + 57 * cos(i * 0.4488 + 0.2)) y1=(100 + 57 * sin(i * 0.4488 + 0.2)) x2=(98 + (i % 2 == 0 ? 76 : 69) * cos(i * 0.4488 + 0.2)) y2=(100 + (i % 2 == 0 ? 76 : 69) * sin(i * 0.4488 + 0.2))
                stroke="honey" stroke-width=1.8 opacity=0.9 stroke-linecap="round" pathLength=1 stroke-dasharray="1 2" stroke-dashoffset=(w >= 4 ? 0 : w == 3 ? 0.45 : 1)
                transition=(still ? "none" : `stroke-dashoffset ${cooling ? 1400 : 700}ms ease ${cooling ? 0 : 200 + i * 45}ms`)
          circle cx=98 cy=100 r=(50 + 10 * w) fill="url(#rd-halo)" opacity=(0.22 + 0.2 * w)
            transition=(still ? "none" : `r ${cooling ? 2000 : 900}ms ease, opacity ${cooling ? 2000 : 900}ms ease`)
          g transform="translate(98 102) scale(1.32)"
            g transform-box="fill-box" transform-origin="center" animation=(still ? "none" : "rd-glow 5s ease-in-out infinite")
              path d="M-31 6C-33 -10 -21 -24 -5 -26C12 -28 28 -19 31 -4C34 10 25 23 8 25C-9 28 -28 21 -31 6Z" fill="url(#rd-rest)" filter="brightness(0.74) saturate(0.85)"
              path d="M-31 6C-33 -10 -21 -24 -5 -26C12 -28 28 -19 31 -4C34 10 25 23 8 25C-9 28 -28 21 -31 6Z" fill="url(#rd-warm)" opacity=span(w, 0, 2.4)
                transition=(still ? "none" : `opacity ${cooling ? 2000 : 900}ms ease`)
              path d="M-31 6C-33 -10 -21 -24 -5 -26C12 -28 28 -19 31 -4C34 10 25 23 8 25C-9 28 -28 21 -31 6Z" fill="url(#rd-hot)" opacity=span(w, 1.6, 4)
                transition=(still ? "none" : `opacity ${cooling ? 2000 : 900}ms ease`)
              path d="M-17 -9C-12 -8 -8 -3 -4 1C-5 6 -8 10 -10 15M-4 1C2 -1 8 -2 13 -6C15 -1 18 3 21 6M13 -6C12 -10 11 -14 8 -18" fill="none" stroke=(w >= 2 ? "ember.light" : "ember") stroke-width=0.9 stroke-linecap="round" stroke-linejoin="round"
                opacity=(w >= 2 ? 0.9 : w == 1 ? 0.75 : 0.5) transition=(still ? "none" : `stroke ${cooling ? 2000 : 900}ms ease, opacity ${cooling ? 2000 : 900}ms ease`)
              path d="M-31 6C-33 -10 -21 -24 -5 -26C12 -28 28 -19 31 -4C34 10 25 23 8 25C-9 28 -28 21 -31 6Z" fill="none" stroke="ink" stroke-width=0.9 opacity=0.4
          // Motes of warmth: more of them as context gathers.
          for i in range(9) key=i
            g opacity=(i < w * 2.25 ? 1 : 0) transition=(still ? "none" : `opacity ${cooling ? 1800 : 800}ms ease`)
              circle cx=(98 + (rnd(i) - 0.5) * 62) cy=(still ? 62 - rnd(i + 30) * 44 : 70 - rnd(i + 30) * 8) r=(1.3 + rnd(i + 12) * 1.1) fill=(i % 3 == 0 ? "honey" : "ember") opacity=(still ? 0.5 : 1)
                animation=(still ? "none" : `rd-rise ${3 + rnd(i + 50) * 2.4}s linear ${0 - rnd(i + 70) * 5}s infinite`)
        // The chart: what lifts, in what order, as context is added.
        g
          line x1=188 y1=178 x2=328 y2=178 stroke="ink.faint" stroke-width=1 stroke-linecap="round"
          for k in range(4) key=k
            circle cx=rdX(k + 1) cy=178 r=2.2 fill=(k < w ? "ember" : "ink.faint") transition=(still ? "none" : "fill 500ms ease")
          text "context →" x=188 y=194 font-size=9.5 fill="ink.soft"
          path d=`${rdArousalPath(w)}L${rdX(w).toFixed(1)} 178L188 178Z` fill="url(#rd-fill-arousal)" transition=(still ? "none" : `d ${cooling ? 1800 : 900}ms ease`)
          path d=`${rdDesirePath(w)}L${rdX(max(w, 2.3)).toFixed(1)} 178L${rdX(2.3)} 178Z` fill="url(#rd-fill-desire)" opacity=(w >= 3 ? 1 : 0)
            transition=(still ? "none" : `d ${cooling ? 1800 : 900}ms ease, opacity ${cooling ? 1200 : 500}ms ease`)
          path d=rdArousalPath(w) fill="none" stroke="ember" stroke-width=2.6 stroke-linecap="round" stroke-linejoin="round" transition=(still ? "none" : `d ${cooling ? 1800 : 900}ms ease`)
          path d=rdDesirePath(w) fill="none" stroke="honey" stroke-width=2.6 stroke-linecap="round" stroke-linejoin="round" opacity=(w >= 3 ? 1 : 0)
            transition=(still ? "none" : `d ${cooling ? 1800 : 900}ms ease, opacity ${cooling ? 1200 : 500}ms ease`)
          circle cx=rdX(w) cy=rdArousal(w) r=3.6 fill="ember" transition=(still ? "none" : `cx ${cooling ? 1800 : 900}ms ease, cy ${cooling ? 1800 : 900}ms ease`)
          circle cx=rdX(max(w, 2.3)) cy=rdDesire(w) r=3.6 fill="honey" opacity=(w >= 3 ? 1 : 0)
            transition=(still ? "none" : `cx ${cooling ? 1800 : 900}ms ease, cy ${cooling ? 1800 : 900}ms ease, opacity ${cooling ? 1200 : 500}ms ease`)
          text "Arousal" text-anchor="end" x=(rdX(w) - 6) y=(rdArousal(w) - 8) font-size=11 fill="ink" opacity=(w >= 1 ? 1 : 0)
            transition=(still ? "none" : `x ${cooling ? 1800 : 900}ms ease, y ${cooling ? 1800 : 900}ms ease, opacity 500ms ease`)
          if w >= 3
            text "Desire" testId="rd-desire" text-anchor="end" x=(rdX(w) - 9) y=(rdDesire(w) + 4) font-size=11 fill="ink"
              transition=(still ? "none" : `x ${cooling ? 1800 : 900}ms ease, y ${cooling ? 1800 : 900}ms ease`)
        // The order, fixed.
        g font-size=10.5 fill="ink.soft"
          line x1=92 y1=214 x2=106 y2=214 stroke="ember" stroke-width=2.6 stroke-linecap="round"
          text "Arousal" x=112 y=217.6
          text "→" x=155 y=217.6
          line x1=172 y1=214 x2=186 y2=214 stroke="honey" stroke-width=2.6 stroke-linecap="round"
          text "then desire" x=192 y=217.6
      Caption(line=rdLine(w, cooling))
      row gap=8 justify-content="center" flex-wrap="wrap"
        Chip(label="Unhurried time", on=on.includes("time"), tone="ember", press=toggle("time"), tid="rd-time")
        Chip(label="Feeling close", on=on.includes("close"), tone="ember", press=toggle("close"), tid="rd-close")
        Chip(label="Welcome touch", on=on.includes("touch"), tone="ember", press=toggle("touch"), tid="rd-touch")
        Chip(label="Nothing to prove", on=on.includes("prove"), tone="ember", press=toggle("prove"), tid="rd-prove")
