// The Whole Clitoris: drag down through the skin and the rest of the organ
// appears, part by part. What looked like a bead is the tip of something the
// size of a hand's width.
use clamp01, span, Caption, Chip from "./kit.contract"
use Organ from "./organ.contract"

fn depthLine(r: number): string = r < 0.1 ? "From outside, the clitoris is a small bead under a hood. That bead is the glans: only the tip." : r < 0.36 ? "Just under the skin, the body runs up and back from the glans, then turns." : r < 0.66 ? "Two bulbs of erectile tissue sit either side of the vaginal opening. They swell with arousal." : "Two legs, the crura, reach back along the pelvic bone. All of this is the clitoris: about nine centimetres, mostly unseen."

component ClitoralStructure
  inject
    still: bool
  props
    uid: string
  state reveal = 0
  state down = false
  action press(e: PointerEvent)
    down = true
    reveal = clamp01((e.offsetY / frame(`cs-${uid}`).height * 330 - 50) / 230)
  action drag(e: PointerEvent)
    if down
      reveal = clamp01((e.offsetY / frame(`cs-${uid}`).height * 330 - 50) / 230)
  action release(e: PointerEvent)
    down = false
  action step(k: string, e: KeyboardEvent)
    if k == "ArrowDown" or k == "ArrowRight"
      preventDefault()
      reveal = clamp01(reveal + 0.1)
    if k == "ArrowUp" or k == "ArrowLeft"
      preventDefault()
      reveal = clamp01(reveal - 0.1)
  action go(r: number)
    reveal = r
  view
    column gap=14
      svg id=`cs-${uid}` testId="cs-stage" viewBox="0 0 340 330" width="100%" display="block" touch-action="none" tabindex=0
        role="slider" aria-label="Depth beneath the skin" aria-valuetext=depthLine(reveal) key=step
        pointerdown=press pointermove=drag pointerup=release
        outline="none" border-radius=16
        :focus-visible
          box-shadow="0 0 0 2px ember"
        Organ(reveal=reveal, swell=0, focus="", glide=(not down and not still))
        // Labels arrive with their parts.
        g font-size=11.5 fill="ink.soft"
          g opacity=1
            line x1=182 y1=102 x2=262 y2=102 stroke="ink.faint" stroke-width=1
            text "Glans" x=266 y=106
          g opacity=(1 - span(reveal, 0.05, 0.3))
            line x1=186 y1=88 x2=262 y2=76 stroke="ink.faint" stroke-width=1
            text "Hood" x=266 y=80
          g opacity=span(reveal, 0.14, 0.36)
            line x1=178 y1=68 x2=228 y2=44 stroke="ink.faint" stroke-width=1
            text "Body" x=232 y=44
          g opacity=span(reveal, 0.4, 0.66)
            line x1=120 y1=190 x2=66 y2=176 stroke="ink.faint" stroke-width=1
            text "Bulbs" x=62 y=174 text-anchor="end"
          g opacity=span(reveal, 0.7, 0.95)
            line x1=262 y1=200 x2=292 y2=186 stroke="ink.faint" stroke-width=1
            text "Legs" x=296 y=184
            text "(crura)" x=296 y=197 font-size=10
        // The depth rail.
        g
          line x1=22 y1=50 x2=22 y2=280 stroke="ink.faint" stroke-width=3 stroke-linecap="round"
          line x1=22 y1=50 x2=22 y2=(50 + 230 * reveal) stroke="ember" stroke-width=3 stroke-linecap="round"
          circle cx=22 cy=(50 + 230 * reveal) r=9 fill="paper" stroke="ember" stroke-width=3
          text "Skin" x=22 y=36 text-anchor="middle" font-size=10.5 fill="ink.soft"
          text "Deep" x=22 y=302 text-anchor="middle" font-size=10.5 fill="ink.soft"
      Caption(line=depthLine(reveal))
      row gap=8 justify-content="center" flex-wrap="wrap"
        Chip(label="Skin", on=(reveal < 0.1), tone="ember", press=go(0), tid="cs-skin")
        Chip(label="Body", on=(reveal >= 0.1 and reveal < 0.36), tone="ember", press=go(0.3), tid="cs-body")
        Chip(label="Bulbs", on=(reveal >= 0.36 and reveal < 0.66), tone="ember", press=go(0.6), tid="cs-bulbs")
        Chip(label="Legs", on=(reveal >= 0.66), tone="ember", press=go(1), tid="cs-legs")
