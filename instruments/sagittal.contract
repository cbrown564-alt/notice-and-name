// The pelvis in mid-sagittal section, front of the body to the left: the one
// drawing five instruments share. Drawn into a 340 x 300 stage as a `g`.
//
// The vagina is a straight, collapsed tube: its opening at (150, 236), running
// up and back at 45 degrees for 179.4 units, 5.6 units from midline to wall.
// Everything an instrument needs to line an overlay up with it is a `fn`
// below, in stage units, so nothing is measured twice.
//
//   tilt      degrees; the whole pelvis turns about the vaginal opening
//             (positive: the pubic bone curls up and forward)
//   clit      0-1  light the internal clitoris (bulb and crus, ghosted in)
//   glans     0-1  light the glans; the body lights with both
//   urethra   0-1  light the urethra and the spongy tissue around it
//   wall      0-1  light the front vaginal wall
//   dentFrom, dentAt, dent
//             something pressing a wall outwards: the wall leaves its line at
//             `dentFrom`, is furthest out at `dentAt` (both in units along the
//             canal) by `dent` units (positive: front wall; negative: back)
//   pulse     the lit clitoris beats, glans to bulb in step
//   names     0-1  opacity of the quiet orientation labels
//   glide     transitions on (off while a finger is dragging)
use clamp, clamp01, lerp, ease, span from "./kit.contract"

// The canal's frame. `t` is depth along it, 0 at the opening and 1 at the top;
// `off` is distance from its midline, positive toward the front wall.
fn sagOX(): number = 150
fn sagOY(): number = 236
fn sagLen(): number = 179.4
fn sagHalf(): number = 5.6
fn sagAngle(): number = 45
fn sagX(t: number, off: number): number = 150 + 0.70711 * (179.4 * t - off)
fn sagY(t: number, off: number): number = 236 - 0.70711 * (179.4 * t + off)
// And back again: where a point of the stage falls in the canal's frame.
fn sagDepth(x: number, y: number): number = 0.70711 * ((x - 150) - (y - 236)) / 179.4
fn sagOff(x: number, y: number): number = -0.70711 * ((x - 150) + (y - 236))
// The glans, and the nearest point to (x, y) on the spine of the internal
// clitoral tissue (it runs beside the urethra and the outer front wall).
fn sagGlansX(): number = 94.1
fn sagGlansY(): number = 229.5
fn sagBulbT(x: number, y: number): number = clamp01(((x - 138.3) * 45.5 - (y - 216.5) * 42.9) / 3910.7)
fn sagBulbX(x: number, y: number): number = 138.3 + 45.5 * sagBulbT(x, y)
fn sagBulbY(x: number, y: number): number = 216.5 - 42.9 * sagBulbT(x, y)
// How close the front wall at depth `t` lies to that tissue: 1 a few
// centimetres in, falling away toward the opening and to nothing by halfway.
fn sagNear(t: number): number = t < 0.22 ? lerp(0.5, 1, ease(t / 0.22)) : 1 - ease(span(t, 0.22, 0.52))
// A square root (Contract has none): Newton's method from a fair first guess.
fn sagNewton(x: number, g: number): number = (g + x / g) / 2
fn sagRoot(x: number): number = x <= 0 ? 0 : sagNewton(x, sagNewton(x, sagNewton(x, sagNewton(x, sagNewton(x, sagNewton(x, 4 + x / 60))))))
fn sagDist(ax: number, ay: number, bx: number, by: number): number = sagRoot((ax - bx) * (ax - bx) + (ay - by) * (ay - by))

// One wall of the canal in the drawing's own units (x along it, y across; `s`
// is -1 for the front wall, 1 for the back), pushed out by `b` from `from` to `at`.
fn sagWall(s: number, from: number, at: number, b: number, off: number): string = `M-22 ${s * off}L${from} ${s * off}L${at} ${s * (off + b)}C${at + 4} ${s * (off + b)} ${at + 8} ${s * (off + b * 0.74)} ${at + 11} ${s * (off + b * 0.42)}S${min(129, at + 18)} ${s * off} ${min(130, at + 23)} ${s * off}L131 ${s * off}`

// The shapes, in the drawing's own units; `sagPlace` sets them on the stage.
// Exported so an instrument can lay a hit region exactly over a tissue.
fn sagPlace(): string = "translate(-34.6 -83.8) scale(1.3)"
fn sagSkinPath(): string = "M40 -90C33 30 33 104 43 158C49 190 57 214 70 232C78 243 88 249 98 249C110 249 122 246 128 245.5C134 245 148 246 156 247.5C166 249 184 250 197 252C214 255 240 266 276 274C304 280 330 264 336 226C342 186 330 120 334 -90"
fn sagBulbPath(): string = "M118 225C130 213 148 200 161 192C171 186 182 190 179 198C175 205 160 219 150 229C144 235 139 240 132 240C124 240 113 232 118 225Z"
fn sagShaftPath(): string = "M99 241C100 232 107 228 121 229"
fn sagUrethraPath(): string = "M128 245C133 234 141 226 150 215C158 206 166 198 172 189"
fn sagUterusPath(): string = "M231 155C225 150 219 144 214 138C208 132 197 131 190 125C184 119 178 114 178 106C177 96 184 88 193 87C203 86 211 93 215 101C219 110 222 119 227 126C232 132 238 138 242.5 144C246 149 244 156 239 157C236 157.5 233 157 231 155Z"
fn sagRectumPath(): string = "M197 253C196 245 192 240 198 232C208 220 240 188 259 167C272 152 281 120 285 80C288 50 292 20 298 -20"

keyframes sag-beat
  50% opacity=0.5

keyframes sag-breathe
  50% opacity=0.6

component Sagittal
  inject
    still: bool
  props
    tilt: number
    clit: number
    glans: number
    urethra: number
    wall: number
    dentFrom: number
    dentAt: number
    dent: number
    pulse: bool
    names: number
    glide: bool
  view
    g
      defs
        linearGradient id="sag-skin" x1=0 y1=0 x2=0 y2=1
          stop offset=0 stop-color="rose" stop-opacity=0.3
          stop offset=1 stop-color="rose" stop-opacity=0.62
        radialGradient id="sag-bone" cx="40%" cy="35%" r="75%"
          stop offset=0 stop-color="bone"
          stop offset=1 stop-color="ink.faint"
        radialGradient id="sag-bladder" cx="45%" cy="40%" r="70%"
          stop offset=0 stop-color="honey.soft" stop-opacity=0.95
          stop offset=1 stop-color="honey.soft" stop-opacity=0.6
        linearGradient id="sag-tissue" x1=0 y1=1 x2=1 y2=0
          stop offset=0 stop-color="rose.deep"
          stop offset=1 stop-color="rose"
        linearGradient id="sag-lit" x1=0 y1=1 x2=1 y2=0
          stop offset=0 stop-color="ember"
          stop offset=1 stop-color="ember.deep"
        radialGradient id="sag-glans" cx="40%" cy="35%" r="75%"
          stop offset=0 stop-color="ember.light"
          stop offset=0.55 stop-color="ember"
          stop offset=1 stop-color="ember.deep"
        radialGradient id="sag-halo"
          stop offset=0 stop-color="ember" stop-opacity=0.6
          stop offset=1 stop-color="ember" stop-opacity=0
        radialGradient id="sag-fade-round" gradientUnits="userSpaceOnUse" cx=168 cy=190 r=215 gradientTransform="matrix(0.86 0 0 1 23.5 0)"
          stop offset=0 stop-color="ink" stop-opacity=1
          stop offset=0.76 stop-color="ink" stop-opacity=1
          stop offset=1 stop-color="ink" stop-opacity=0
        linearGradient id="sag-fade-foot" gradientUnits="userSpaceOnUse" x1=0 y1=0 x2=0 y2=300
          stop offset=0 stop-color="ink" stop-opacity=1
          stop offset=0.9 stop-color="ink" stop-opacity=1
          stop offset=1 stop-color="ink" stop-opacity=0
        mask id="sag-mask-x" mask-type="alpha" maskUnits="userSpaceOnUse" x=0 y=0 width=340 height=300
          rect x=0 y=0 width=340 height=300 fill="url(#sag-fade-round)"
        mask id="sag-mask-y" mask-type="alpha" maskUnits="userSpaceOnUse" x=0 y=0 width=340 height=300
          rect x=0 y=0 width=340 height=300 fill="url(#sag-fade-foot)"
        clipPath id="sag-body"
          path d=`${sagSkinPath()}Z`
      // The body dissolves toward the edges of the stage instead of being cut by them.
      g mask="url(#sag-mask-x)"
        g mask="url(#sag-mask-y)"
          // The anatomy is drawn in its own units and set on the stage here: the
          // vaginal opening, (142, 246) in the drawing, lands on (150, 236).
          g transform=sagPlace()
            g rotate=`${tilt}deg` transform-origin="142px 246px" transition=(glide ? "rotate 700ms ease" : "none")
              // Skin and the soft ground of the body.
              path d=`${sagSkinPath()}Z` fill="url(#sag-skin)"
              // The lips, seen beyond the cut.
              path d="M91 247C95 262 142 270 163 249C140 244 112 244 91 247Z" fill="rose.deep" opacity=0.3
              path d="M91 247C95 262 142 270 163 249" fill="none" stroke="ink" stroke-width=0.9 stroke-linecap="round" opacity=0.3
              path d=sagSkinPath() fill="none" stroke="ink" stroke-width=1.1 stroke-linecap="round" opacity=0.42
              // Context, kept quiet: the base of the spine, the rectum, the uterus.
              path d="M318 -20C320 60 320 122 302 172C296 188 290 200 283 208C281 201 286 188 290 172C302 122 302 60 300 -20Z" fill="bone" opacity=0.7
              path d=sagRectumPath() fill="none" stroke="ink.faint" stroke-width=19 opacity=0.5
              path d=sagRectumPath() fill="none" stroke="ink" stroke-width=0.8 stroke-dasharray="1 5" stroke-linecap="round" opacity=0.3
              path d=sagUterusPath() fill="ink.faint" opacity=0.55
              path d=sagUterusPath() fill="none" stroke="ink" stroke-width=0.9 opacity=0.22
              path d="M237 150C229 140 217 126 200 107" fill="none" stroke="ink" stroke-width=0.9 stroke-linecap="round" opacity=0.2
              // The pubic bone.
              path d="M95 168C99 158 113 160 117 172C122 186 129 204 125 214C121 224 109 220 105 210C100 198 91 180 95 168Z" fill="url(#sag-bone)" stroke="ink" stroke-width=0.9 stroke-opacity=0.4
              // The bladder.
              path d="M172 189C162 190 138 184 132 168C126 152 138 134 156 132C176 130 192 144 190 162C189 174 182 186 172 189Z" fill="url(#sag-bladder)" stroke="ink" stroke-width=0.9 stroke-opacity=0.34
              // The vagina: the space between, the two walls, and anything pressing them out.
              g clip-path="url(#sag-body)"
                g transform="translate(142 246) rotate(-45)"
                  path d="M-22 0L131 0" fill="none" stroke="ember.deep" stroke-width=8.62 stroke-linecap="round" opacity=0.26
                  path d=`${sagWall(-1, dentFrom / 1.3, dentAt / 1.3, max(0, dent) / 1.3, 4.31)}Z` fill="ember.deep" opacity=0.26 transition=(glide ? "d 700ms ease" : "none")
                  path d=`${sagWall(1, dentFrom / 1.3, dentAt / 1.3, max(0, -dent) / 1.3, 4.31)}Z` fill="ember.deep" opacity=0.26 transition=(glide ? "d 700ms ease" : "none")
                  path d="M-22 0L129 0" fill="none" stroke="ink" stroke-width=0.8 stroke-linecap="round" opacity=0.3
                  path d="M131 -6.11A6.11 6.11 0 0 1 131 6.11" fill="none" stroke="rose.deep" stroke-width=3.6 opacity=0.85
                  path d=sagWall(1, dentFrom / 1.3, dentAt / 1.3, max(0, -dent) / 1.3, 6.11) fill="none" stroke="rose.deep" stroke-width=3.6 stroke-linejoin="round" opacity=0.85 transition=(glide ? "d 700ms ease" : "none")
                  path d=sagWall(-1, dentFrom / 1.3, dentAt / 1.3, max(0, dent) / 1.3, 6.11) fill="none" stroke="rose.deep" stroke-width=3.6 stroke-linejoin="round" opacity=0.85 transition=(glide ? "d 700ms ease" : "none")
                  // The front wall, lit.
                  g opacity=wall transition=(glide ? "opacity 500ms ease" : "none")
                    path d=sagWall(-1, dentFrom / 1.3, dentAt / 1.3, max(0, dent) / 1.3, 6.8) fill="none" stroke="rose.deep" stroke-width=12 stroke-linejoin="round" opacity=0.6 filter="blur(3px)"
                    path d=sagWall(-1, dentFrom / 1.3, dentAt / 1.3, max(0, dent) / 1.3, 6.11) fill="none" stroke="rose.deep" stroke-width=5 stroke-linejoin="round"
                    path d=sagWall(-1, dentFrom / 1.3, dentAt / 1.3, max(0, dent) / 1.3, 6.11) fill="none" stroke="ember.light" stroke-width=1.3 stroke-linejoin="round" opacity=0.75
              // The urethra, from the bladder's neck down to its opening.
              path d=sagUrethraPath() fill="none" stroke="ink.soft" stroke-width=2.2 stroke-linecap="round" opacity=0.6
              // The clitoris at rest. The internal tissue really lies to either
              // side of the midline, so it is ghosted over what it flanks.
              g animation=(still ? "none" : "sag-breathe 5.5s ease-in-out infinite")
                path d=sagBulbPath() fill="url(#sag-tissue)" opacity=0.5
              path d=sagBulbPath() fill="none" stroke="ink" stroke-width=0.8 stroke-dasharray="2 3" stroke-linecap="round" opacity=(0.45 - 0.33 * clit) transition=(glide ? "opacity 600ms ease" : "none")
              path d=sagShaftPath() fill="none" stroke="rose.deep" stroke-width=6.2 stroke-linecap="round"
              circle cx=99 cy=241 r=5.2 fill="rose.deep" stroke="ink" stroke-width=0.8 stroke-opacity=0.35
              // The clitoris, lit: one layer, so every part of it beats together.
              g animation=(pulse and not still ? "sag-beat 2.4s ease-in-out infinite" : "none")
                g opacity=clit transition=(glide ? "opacity 600ms ease" : "none")
                  path d=sagBulbPath() fill="ember" opacity=0.5 filter="blur(5px)"
                  path d=sagBulbPath() fill="url(#sag-lit)" opacity=0.8
                g opacity=clamp01(glans * 0.5 + clit * 0.5) transition=(glide ? "opacity 600ms ease" : "none")
                  path d=sagShaftPath() fill="none" stroke="ember" stroke-width=6.2 stroke-linecap="round"
                g opacity=glans transition=(glide ? "opacity 600ms ease" : "none")
                  circle cx=99 cy=241 r=17 fill="url(#sag-halo)"
                  circle cx=99 cy=241 r=5.6 fill="url(#sag-glans)"
              // The urethra, lit, with the spongy tissue around it: drawn over the
              // clitoris so each of the three still reads when all are on.
              g opacity=urethra transition=(glide ? "opacity 500ms ease" : "none")
                path d=sagUrethraPath() fill="none" stroke="honey" stroke-width=13 stroke-linecap="round" opacity=0.55 filter="blur(3px)"
                path d=sagUrethraPath() fill="none" stroke="honey" stroke-width=5 stroke-linecap="round"
                path d=sagUrethraPath() fill="none" stroke="ember.light" stroke-width=1.4 stroke-linecap="round" opacity=0.85
              // Orientation, for the instruments that want it.
              g font-size=8.2 fill="ink.soft" opacity=names transition=(glide ? "opacity 500ms ease" : "none")
                text "Pubic bone" x=63 y=180 text-anchor="middle"
                text "Bladder" x=160 y=164 text-anchor="middle"
                text "Uterus" x=199 y=112 text-anchor="middle"
                text "Rectum" x=262 y=198 text-anchor="middle"
