// Notice & Name: a private atlas of pleasure, taught by drawings you can touch.
// This file is the shell: three tabs, each its own stack. A concept's page is
// concept.contract; every instrument is a file under instruments/.
use Concept, Chapter, Pathway, Prompt, Library, Note, Reply, Time, Media from "./shapes.contract"
use ConceptPage from "./concept.contract"
use Serif, Eyebrow from "./instruments/kit.contract"
use Glyph from "./instruments/glyphs.contract"
use Emblem from "./instruments/emblem.contract"

routes nav
  tab today "/"
    todayConcept "/today/:id"
  tab atlas "/atlas"
    concept "/atlas/:id"
  tab yours "/yours"
    yoursConcept "/yours/:id"

fn isConcept(name: string): bool = name == "concept" or name == "todayConcept" or name == "yoursConcept"
fn nameOf(lib: Library, id: string): string = match first(lib.concepts.filter(c => c.id == id)) { case some(c) => c.name, case none => "" }
fn chapterOf(lib: Library, id: string): string = match first(lib.concepts.filter(c => c.id == id)) { case some(c) => c.chapter, case none => "" }
fn statusOf(id: string, resonates: string[], curious: string[], passed: string[]): string = resonates.includes(id) ? "resonates" : curious.includes(id) ? "curious" : passed.includes(id) ? "passed" : ""

style Page
  gap=28
  padding="8px 20px 48px"
  max-width="42rem"
  width="100%"
  margin="0 auto"
  box-sizing="border-box"

style Card
  background-color="paper.raised"
  border-radius=22
  padding=18

style Lead
  font-size="1.0625rem"
  line-height=1.5

component App
  resource lib = library() as shape Library else empty()
  resource notes = loadNotes() as shape Note[] else empty()
  resource time = exactTime() as shape Time
  resource media = exactViewport() as shape Media
  mutation noted as shape Reply queue refreshes notes
  state resonates: string[] = [] persist
  state curious: string[] = [] persist
  state passed: string[] = [] persist
  state kept: string[] = [] persist
  state opened: string[] = [] persist
  state welcomed = false persist
  derive still = media.prefersReducedMotion
  // Room for the instrument beside the words (the sidebar takes 240 of it).
  derive wide = media.width >= 1040
  members "./engine.contract"
  derive day = formatDate(time.epochAtZero + performanceNow(), time.utcOffset, "medium")
  // One prompt a day, in order, by the local calendar day.
  derive promptAt = lib.prompts.length == 0 ? 0 : floor((time.epochAtZero + time.utcOffset * 60000) / 86400000) % lib.prompts.length
  derive keptPhrases = lib.concepts.map(c => c.phrases.filter(p => kept.includes(p.id))).flat()
  mutation erased as shape Reply refreshes notes
  task visit key=top(nav).id
    change(markOpened)
  provide
    still
    wide
    aMode
    aLevel
    aInput
    aTrace
    aNear
    aEdges
    aReleasing
    aTouched
    aBegin
    aEnd
    aReset
  action pick(name: string)
    nav = select(nav, name)
  action follow(url: string)
    nav = go(nav, url)
  action setStatus(id: string, s: string)
    let was = statusOf(id, resonates, curious, passed)
    resonates = s == "resonates" and was != s ? resonates.filter(x => x != id).concat([id]) : resonates.filter(x => x != id)
    curious = s == "curious" and was != s ? curious.filter(x => x != id).concat([id]) : curious.filter(x => x != id)
    passed = s == "passed" and was != s ? passed.filter(x => x != id).concat([id]) : passed.filter(x => x != id)
  action toggleKeep(id: string)
    kept = kept.includes(id) ? kept.filter(k => k != id) : kept.concat([id])
  action addNote(conceptId: string, body: string)
    send noted = addNote(conceptId, body, day)
  action removeNote(id: string)
    send noted = removeNote(id)
  action markOpened
    if isConcept(top(nav).name) and not opened.includes(top(nav).params.id)
      opened = opened.concat([top(nav).params.id])
  action begin
    welcomed = true
    nav = go(nav, "/today/clitoral-structure")
  action dismiss
    welcomed = true
  action erase
    resonates = []
    curious = []
    passed = []
    kept = []
    opened = []
    send erased = eraseNotes()
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      display="flex" flex-direction="column" background-color="paper" color="ink"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` navigationScroll=`content-${e.id}` position="absolute" inset=0
                display="flex" flex-direction="column" background-color="paper"
                header display="flex" align-items="center" gap=8 padding="8px 16px"
                  text (e.name == "today" ? "Today" : e.name == "atlas" ? "Atlas" : e.name == "yours" ? "Yours" : nameOf(lib, e.params.id))
                    role="heading" aria-level=(isConcept(e.name) ? 2 : 1) flex=1
                scroll id=`content-${e.id}` flex=1 min-height=0
                  if isConcept(e.name)
                    for c in lib.concepts.filter(x => x.id == e.params.id) key=c.id
                      ConceptPage(c=c, lib=lib, tab=t.name, uid=`${e.id}`, status=statusOf(c.id, resonates, curious, passed), kept=kept,
                        notes=notes.filter(n => n.conceptId == c.id), setStatus=setStatus, toggleKeep=toggleKeep, addNote=addNote, removeNote=removeNote)
                  else if e.name == "atlas"
                    column class=Page max-width="60rem"
                      for ch in lib.chapters key=ch.id
                        column gap=12
                          column gap=4
                            text ch.name role="heading" aria-level=2 class=Serif font-size="1.625rem" font-weight=600
                            text ch.blurb color="ink.soft" font-size="0.9375rem"
                          row flex-wrap="wrap" gap=12
                            for c in lib.concepts.filter(x => x.chapter == ch.id) key=c.id
                              link href=path("concept", c.id) testId=`atlas-${c.id}` display="flex" align-items="center" gap=14 class=Card padding=12 text-decoration="none" color="ink"
                                flex="1 1 280px" min-width=0 box-sizing="border-box"
                                Glyph(id=c.id, chapter=c.chapter)
                                column flex=1 min-width=0 gap=2
                                  text c.name class=Serif font-size="1.125rem" font-weight=600
                                  text c.tagline font-size="0.9375rem" color="ink.soft"
                                if statusOf(c.id, resonates, curious, passed) != ""
                                  box width=9 height=9 border-radius=5 flex-shrink=0 role="img"
                                    aria-label=(resonates.includes(c.id) ? "Resonates" : curious.includes(c.id) ? "Curious" : "Not for me")
                                    background-color=(resonates.includes(c.id) ? "ember" : curious.includes(c.id) ? "honey" : "ink.faint")
                                image "symbol:forward-chevron" color="ink.soft"
                  else if e.name == "today"
                    column class=Page
                      if not welcomed
                        column class=Card gap=16 padding=22 testId="welcome"
                          Emblem(still=still)
                          column gap=8
                            text "Notice what you like. Name it." role="heading" aria-level=2 class=Serif font-size="1.75rem" font-weight=600 line-height=1.2
                            text "An atlas of pleasure you learn with your hands: every idea here is a drawing you can touch, built on published research." class=Lead color="ink.soft"
                          column gap=10
                            for line in ["Private: no account, nothing leaves this device.", "Unhurried: nothing to finish, score or keep up.", "Yours: keep the words that fit, pass on the rest."] key=line
                              row gap=10 align-items="baseline"
                                box width=7 height=7 border-radius=4 background-color="ember" flex-shrink=0
                                text line font-size="0.9375rem" line-height=1.4 flex=1 min-width=0
                          row gap=10 flex-wrap="wrap"
                            button press=begin buttonStyle="filled" testId="welcome-begin"
                              text "Begin with the map"
                            button press=dismiss testId="welcome-dismiss"
                              text "Look around first"
                      for p in lib.prompts.slice(promptAt, promptAt + 1) key=p.id
                        column gap=12
                          text day class=Eyebrow
                          text p.text role="heading" aria-level=2 class=Serif font-size="1.625rem" line-height=1.3 testId="prompt"
                          link href=`/today/${p.conceptId}` testId="prompt-concept" display="flex" align-items="center" gap=14 class=Card padding=12 text-decoration="none" color="ink"
                            Glyph(id=p.conceptId, chapter=chapterOf(lib, p.conceptId))
                            column flex=1 min-width=0 gap=2
                              text "Today's idea" font-size="0.8125rem" font-weight=600 color="ink.soft"
                              text nameOf(lib, p.conceptId) class=Serif font-size="1.125rem" font-weight=600
                            image "symbol:forward-chevron" color="ink.soft"
                      column gap=12
                        column gap=4
                          text "Paths" role="heading" aria-level=2 class=Serif font-size="1.625rem" font-weight=600
                          text "Five ways through the atlas. Take any of them, in any order." color="ink.soft" font-size="0.9375rem"
                        for w in lib.pathways key=w.id
                          column class=Card gap=10 testId=`path-${w.id}`
                            column gap=3
                              text w.name class=Serif font-size="1.1875rem" font-weight=600
                              text w.summary font-size="0.9375rem" line-height=1.4 color="ink.soft"
                            row gap=6 align-items="center" role="img" aria-label=`${w.conceptIds.filter(id => opened.includes(id)).length} of ${w.conceptIds.length} opened`
                              for id in w.conceptIds key=id
                                box height=6 flex=1 border-radius=3 background-color=(opened.includes(id) ? "ember" : "paper.sunk") transition="background-color 400ms ease"
                            for id in w.conceptIds.filter(x => not opened.includes(x)).slice(0, 1) key=id
                              link href=`/today/${id}` testId=`path-next-${w.id}` display="flex" align-items="center" gap=8 text-decoration="none" color="ember.deep" font-weight=600 font-size="0.9375rem"
                                text `Next: ${nameOf(lib, id)}` flex=1 min-width=0
                                image "symbol:forward-chevron"
                            if w.conceptIds.filter(x => not opened.includes(x)).length == 0
                              text "You have been through all of these. They are still here whenever you want them." font-size="0.9375rem" color="ink.soft"
                  else
                    column class=Page
                      column gap=6
                        text "Your vocabulary" role="heading" aria-level=2 class=Serif font-size="1.625rem" font-weight=600
                        text "The words that fit you, the sentences worth keeping, and what you have noticed." color="ink.soft" font-size="0.9375rem"
                      if resonates.length + curious.length + passed.length == 0
                        column class=Card gap=10 testId="words-empty"
                          text "No words yet" class=Serif font-size="1.1875rem" font-weight=600
                          text "Open any idea in the Atlas and say how it lands: resonates, curious, or not for me. Each one is useful to know." font-size="0.9375rem" line-height=1.45 color="ink.soft"
                          row
                            button press=pick("atlas") buttonStyle="bordered" testId="words-open-atlas"
                              text "Open the Atlas"
                      for group in ["resonates", "curious", "passed"] key=group
                        if (group == "resonates" ? resonates : group == "curious" ? curious : passed).length > 0
                          column gap=10
                            text (group == "resonates" ? "Resonates" : group == "curious" ? "Curious about" : "Not for me") class=Eyebrow
                            row gap=8 flex-wrap="wrap" testId=`words-${group}`
                              for id in (group == "resonates" ? resonates : group == "curious" ? curious : passed) key=id
                                link href=`/yours/${id}` testId=`word-${id}` text-decoration="none" padding="9px 15px" border-radius=999
                                  background-color=(group == "resonates" ? "ember.glow" : group == "curious" ? "honey.soft" : "paper.sunk") color="ink" font-weight=500 font-size="0.9375rem"
                                  text nameOf(lib, id)
                      column gap=10
                        text "Kept phrases" class=Eyebrow
                        if keptPhrases.length == 0
                          text "Sentences you keep from any idea's “Say it” collect here, ready when you want them." font-size="0.9375rem" line-height=1.45 color="ink.soft" testId="phrases-empty"
                        for p in keptPhrases key=p.id
                          column class=Card gap=8
                            text p.label font-size="0.8125rem" font-weight=600 color="ink.soft"
                            text p.body class=Serif font-size="1.125rem" line-height=1.4 testId=`kept-${p.id}`
                            row justify-content="flex-end"
                              button press=toggleKeep(p.id) aria-label="Remove from kept phrases" testId=`unkeep-${p.id}`
                                image "symbol:bookmark-fill"
                      column gap=10
                        text "Field notes" class=Eyebrow
                        if notes.length == 0
                          text "Private notes you write under any idea's “Reflect” appear here." font-size="0.9375rem" line-height=1.45 color="ink.soft" testId="notes-empty"
                        for n in notes key=n.id
                          column class=Card gap=6
                            row gap=8 align-items="baseline"
                              link href=`/yours/${n.conceptId}` text-decoration="none" color="ember.deep" font-weight=600 font-size="0.9375rem" flex=1 min-width=0
                                text nameOf(lib, n.conceptId)
                              text n.day font-size="0.8125rem" color="ink.soft"
                            text n.text class=Lead white-space="pre-wrap" testId=`yours-note-${n.id}`
                            row
                              button press=removeNote(n.id) testId=`yours-note-remove-${n.id}`
                                text "Delete"
                      column class=Card gap=10
                        text "Private by design" class=Serif font-size="1.1875rem" font-weight=600
                        text "There is no account and no server. Your words, phrases and notes are stored only on this device, and you can erase them at any moment." font-size="0.9375rem" line-height=1.45 color="ink.soft"
                        row
                          button commandfor="erase-all" command="show-modal" testId="erase-open"
                            text "Erase everything"
      dialog id="erase-all" role="alertdialog" aria-label="Erase your words, phrases and notes? This cannot be undone."
        button press=erase destructive=true commandfor="erase-all" command="close" testId="erase-confirm"
          text "Erase"
        button commandfor="erase-all" command="close" testId="erase-cancel"
          text "Cancel"
      row role="tablist" testId="tabs"
        button role="tab" aria-controls="panel-today" aria-selected=(nav.tab == "today") press=pick("today") testId="tab-today" flex=1
          image "symbol:sparkles"
          text "Today"
        button role="tab" aria-controls="panel-atlas" aria-selected=(nav.tab == "atlas") press=pick("atlas") testId="tab-atlas" flex=1
          image "symbol:layers"
          text "Atlas"
        button role="tab" aria-controls="panel-yours" aria-selected=(nav.tab == "yours") press=pick("yours") testId="tab-yours" flex=1
          image "symbol:bookmark"
          text "Yours"
