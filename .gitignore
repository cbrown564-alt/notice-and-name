# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated build output
build/
ios/.build/
ios/.swiftpm/
ios/DerivedData/
ios/PleasureVocabulary.xcodeproj/xcuserdata/
ios/PleasureVocabulary.xcodeproj/project.xcworkspace/xcuserdata/

# retired Expo output that may remain in existing checkouts
.expo/
dist/
expo-env.d.ts
ios-native/

# iOS concept media — generated from assets/ via npm run sync-ios-media
ios/Sources/PleasureVocabularyApp/Resources/media/illustrations/*
!ios/Sources/PleasureVocabularyApp/Resources/media/illustrations/.gitkeep
ios/Sources/PleasureVocabularyApp/Resources/media/thumbnails/*
!ios/Sources/PleasureVocabularyApp/Resources/media/thumbnails/.gitkeep
ios/Sources/PleasureVocabularyApp/Resources/media/videos/*
!ios/Sources/PleasureVocabularyApp/Resources/media/videos/.gitkeep
ios/Sources/PleasureVocabularyApp/Resources/media/explainers/*
!ios/Sources/PleasureVocabularyApp/Resources/media/explainers/.gitkeep
