{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pleasure-vocabulary-builder.local/schema/content-bundle.schema.json",
  "title": "Notice & Name V2 Content Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleId", "contentVersion", "generatedAt", "concepts", "pathways", "media"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.-]+)?$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "pathways": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pathway"
      }
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mediaItem"
      }
    },
    "explainers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/explainer"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
        "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "reviewStatus", "definition", "summary", "blocks", "relatedConceptIds", "phraseTemplates", "citations"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": ["technique", "sensation", "timing", "psychological", "anatomy"]
        },
        "reviewStatus": {
          "enum": ["draft", "reviewed", "approved", "retired"]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "relatedConceptIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "phraseTemplates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phraseTemplate"
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "mediaIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "body"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": ["recognize", "definition", "mechanism", "media", "reflection", "phrase"]
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "citationIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "mediaId": {
          "$ref": "#/$defs/id"
        },
        "privateByDefault": {
          "type": "boolean"
        }
      }
    },
    "phraseTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "body", "tone", "useCase"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "tone": {
          "enum": ["soft", "direct", "curious", "reassuring"]
        },
        "useCase": {
          "enum": ["self-understanding", "partner-request", "boundary", "curiosity", "reassurance"]
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "source"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "pathway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "intent", "conceptIds"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "intent": {
          "enum": ["understand-body", "notice-patterns", "communicate", "try-something", "return-to-presence"]
        },
        "conceptIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "mediaItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "reducedMotionFallback"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["image", "video", "diagram"]
        },
        "path": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "reducedMotionFallback": {
          "type": "string"
        }
      }
    },
    "explainerContentBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "body"],
      "properties": {
        "type": {
          "enum": ["text", "quote", "callout"]
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        }
      }
    },
    "explainerStatistic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label", "source"],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "explainerSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "contentBlocks"],
      "properties": {
        "title": {
          "type": "string"
        },
        "contentBlocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/explainerContentBlock"
          }
        },
        "statistic": {
          "$ref": "#/$defs/explainerStatistic"
        }
      }
    },
    "explainerMisconception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["myth", "fact"],
      "properties": {
        "myth": {
          "type": "string"
        },
        "fact": {
          "type": "string"
        }
      }
    },
    "explainerSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation", "finding"],
      "properties": {
        "citation": {
          "type": "string"
        },
        "finding": {
          "type": "string"
        }
      }
    },
    "explainer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "subtitle",
        "icon",
        "readTime",
        "overview",
        "keyTakeaways",
        "sections",
        "misconceptions",
        "keySources",
        "relatedConceptIds",
        "relatedExplainerIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "heroImageId": {
          "$ref": "#/$defs/id"
        },
        "readTime": {
          "type": "string"
        },
        "overview": {
          "type": "string"
        },
        "keyTakeaways": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/explainerSection"
          }
        },
        "misconceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/explainerMisconception"
          }
        },
        "keySources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/explainerSource"
          }
        },
        "relatedConceptIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "relatedExplainerIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}
